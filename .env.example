# pr-review-agent config — copy this file to `.env` and fill in your values.
# Both vars are required; the daemon refuses to run without them set in either
# this file or the shell environment. See CLAUDE.md Forking section.

# Repo URL surfaced in Review-body footer link and preview-release banner.
PR_REVIEW_PROJECT_URL=https://github.com/<your-org>/<your-fork>

# Display name used in the same two places.
PR_REVIEW_PROJECT_NAME=<your-fork>
