# Space-separated owner/repo pairs to monitor.
REPOS=

# The numeric ID of the GitHub App the daemon posts as (ADR 0036). Shown on the
# App's settings page; the private key it pairs with lives at APP_KEY_PATH
# (default ~/.pr-review-agent/app.pem).
GITHUB_APP_ID=

# How often poll.sh fires (seconds). run.sh's loop sleeps this long between polling cycles.
POLL_INTERVAL_SECONDS=300

# Max review-pr.sh *processes* to run concurrently within one polling cycle
# (ADR 0013). As of ADR 0023's revision this no longer bounds concurrent
# `claude -p` load directly (CLAUDE_SLOT_POOL_SIZE below does that, shared
# across every concurrent process), so this dial is now about process/disk/
# scratch-clone overhead; raise it freely on a capable machine. 3 lets up to 3
# PRs' review-pr.sh processes exist at once, a starting point for a capable
# machine (e.g. an M-series Mac with headroom); adjust after dogfooding.
# Re-read each cycle, so a change applies on the next cycle without a restart.
MAX_PARALLEL=3

# Global cap on concurrent `claude -p` calls across the whole daemon (ADR 0023
# revision): every review lens and the editor, across every concurrently
# running review-pr.sh process, draws from this one shared pool. Each PR needs
# up to 5 (the current lens count) to run its own lenses with zero internal
# wait, so a pool only as big as one PR's need (5) gives zero headroom for a
# second PR to make any progress even with MAX_PARALLEL raised above 1: one PR
# can hold every slot, and every other concurrent PR just waits. 10 (2 PRs'
# worth) lets MAX_PARALLEL's concurrency actually mean something; scale
# further only against your actual Claude subscription/API concurrency
# headroom and local machine resources, not a fixed number this file can
# safely assume for you. Adjust after dogfooding.
CLAUDE_SLOT_POOL_SIZE=10

# PRs labeled with this string are skipped. Empty string disables the filter.
OPT_OUT_LABEL=no-ai-review

# Confidence gate cutoff, 0-100 (ADR 0022). Findings the review agent scores
# below this are dropped before posting; 80 is the default when unset. Lower it
# to surface more (and noisier) findings, raise it to keep only high-confidence
# ones. review-pr.sh reads this and exports it into the extract step.
CONFIDENCE_THRESHOLD=80

# Findings cap per review (#199). The single-lens hard cap and the post-merge
# truncation both read it; 10 is the default when unset.
MAX_FINDINGS=10

# Reasoning model for every agent claude -p: the review lenses, the editor,
# judge-fix, and reply (#209). Pinned so the daemon runs on one capable model
# instead of inheriting the machine's global ~/.claude/settings.json default,
# which silently reviewed on whatever the operator's shell happened to prefer.
# lib.sh's resolve_review_model holds the default when unset.
REVIEW_MODEL=claude-opus-4-8

# How each lens runs (ADR 0034). `subagent` dispatches a subagent per lens;
# `single-agent` runs the lens in the process that already isolates it, dropping
# the subagent layer that only forwarded its stdout. Measured equal recall at
# 27-39% fewer tokens, so `single-agent` is now both the recommendation and the
# code default when the key is absent (it was `subagent` until the measurement
# stood). Set `subagent` here to opt back into the orchestrator-worker shape.
# Independent of REVIEW_LENSES below.
REVIEW_MODE=single-agent

# Which lenses run (ADR 0034), space-separated, from: general data-flow perf
# security tests intent. Unset runs `general data-flow intent`; `data-flow` is a
# specialist that catches cross-component and state-consistency bugs the broad
# `general` sweep misses (ADR 0037). The three domain lenses (perf, security,
# tests) are off by default (#249), since the eval corpus holds no perf, security,
# or test-quality defect. Turn them on if your repo is one where that domain is the
# point. Fewer lenses cost proportionally less.
#
# `intent` is the odd one out (ADR 0035): it reads the PR's description and any
# linked issue against the diff, so it catches a change that does not do what it
# said it would, which no code-only lens can see. It skips itself at no cost on a
# PR that describes nothing.
REVIEW_LENSES=
