# Space-separated owner/repo pairs to monitor.
REPOS=

# Your GitHub username — used by ADR 0004 own-PR logic and to filter authorship.
GITHUB_USER=

# How often poll.sh fires (seconds). run.sh's loop sleeps this long between polling cycles.
POLL_INTERVAL_SECONDS=300

# Max reviews to run concurrently within one polling cycle (ADR 0013). Default 1
# is serial. The limiter is concurrent `claude -p` load, so keep this small (2-3).
# Re-read each cycle, so a change applies on the next cycle without a restart.
MAX_PARALLEL=1

# Review PRs you authored? (ADR 0004 — default true for solo, set false in team setups
# where a teammate's daemon will cover yours.)
REVIEW_OWN_PRS=true

# PRs labeled with this string are skipped. Empty string disables the filter.
OPT_OUT_LABEL=no-ai-review

# Optional Slack incoming webhook for "review ready" notifications.
SLACK_WEBHOOK_URL=
